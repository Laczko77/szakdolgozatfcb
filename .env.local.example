# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# football-data.org (squad, standings, matches, logos)
FOOTBALL_DATA_API_KEY=your_football_data_api_key

# Sofascore via RapidAPI (player statistics + match team stats)
SOFASCORE_RAPIDAPI_KEY=your_rapidapi_key_here

# E2E tesztek (Playwright)
# Egy normál jogosultságú (role=user) tesztfiók adatai
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=your_test_user_password

# Egy adminisztrátori jogosultságú (role=admin) tesztfiók adatai
TEST_ADMIN_EMAIL=testadmin@example.com
TEST_ADMIN_PASSWORD=your_test_admin_password

# Az alkalmazás alap URL-je teszteléshez (opcionális, alapértelmezett: http://localhost:3000)
# BASE_URL=http://localhost:3000
